# Copy to .env.local and fill in
MONGODB_URI=
# Bearer token that cron.colinfran.com sends to authorize scheduled syncs
# Optional: lets you trigger /api/sync manually with `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
# Scanner data source (DataSF query endpoint). Optional — defaults to the gnap-fj3t dataset.
SCANNER_API_URL=https://data.sf.gov/api/v3/views/gnap-fj3t/query.json
# SODA3 API credentials (data.sf.gov now requires auth). Create at data.sf.gov → Profile → API Keys.
# Sent as HTTP Basic Auth (key = username, secret = password).
SCANNER_API_KEY=
SCANNER_API_SECRET=